{
  "name": "vereinssync",
  "version": "0.1.0",
  "description": "Offline-Desktop-App: spiegelt die Vereinsdaten aus WordPress + Nextcloud lokal und synchronisiert sie zurück.",
  "main": "main.js",
  "author": "Verein",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test \"src/sync/*.test.js\"",
    "test:full": "npm rebuild better-sqlite3 && node --test \"src/sync/*.test.js\"; npm run rebuild",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "@electron/rebuild": "^3.7.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.verein.vereinssync",
    "productName": "Vereinssync",
    "files": ["main.js", "preload.js", "src/**/*", "!**/*.test.js"],
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
